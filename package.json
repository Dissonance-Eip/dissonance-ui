{
  "name": "dissonance-ui",
  "version": "0.1.0",
  "private": true,
  "description": "Dissonance UI Electron shell (JavaScript only)",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "copy-core-addon": "node ./scripts/copy-core-addon.js",
    "dev:copy-start": "npm run copy-core-addon && npm run dev",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check .",
    "build": "npm run copy-core-addon",
    "test": "echo \"No tests yet\""
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "electron": "^28.0.0",
    "eslint": "^9.38.0",
    "globals": "^16.4.0",
    "prettier": "^3.6.2"
  },
  "dependencies": {}
}
