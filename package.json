{
  "name": "dissonance-ui",
  "version": "0.1.0",
  "private": true,
  "description": "Dissonance UI Electron shell (JavaScript only)",
  "main": "main.js",
  "scripts": {
    "build:css": "tailwindcss -c ./tailwind.config.js -i ./tailwind.input.css -o ./tailwind.css",
    "watch:css": "tailwindcss -c ./tailwind.config.js -i ./tailwind.input.css -o ./tailwind.css --watch",
    "prestart": "npm run build:css",
    "predev": "npm run build:css",
    "prebuild": "npm run build:css",
    "start": "electron .",
    "dev": "electron .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check .",
    "build": "electron-builder --dir",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@arraypress/waveform-player": "^1.5.2",
    "bindings": "^1.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "electron": "^40.6.0",
    "electron-builder": "^26.8.1",
    "eslint": "^10.0.1",
    "globals": "^17.3.0",
    "prettier": "^3.6.2",
    "tailwindcss": "^3.4.17",
    "vitest": "^4.1.7"
  }
}
